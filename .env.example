# Copy to .env and replace every example value. Never commit this file.
# Bitrix24 REST webhook URLs (keep the token private).
BITRIX_WEBHOOK=
BITRIX_NOTIFY_WEBHOOK=
TEST_RECIPIENT_ID=

# Active Directory / LDAPS
AD_SERVER=ad-server.example.org
AD_SERVER_HOST=ad-server.example.org
AD_SERVER_IP=192.0.2.10
AD_USER=svc-adsync@example.org
AD_PASSWORD=
AD_UPN_SUFFIX=example.org
AD_BASE_DN=DC=example,DC=org
AD_TLS_VALIDATE=true
# Optional path to a trusted CA bundle mounted inside containers.
AD_TLS_CA_CERT=
# Set this only if your deployment deliberately uses a different group name.
ADMIN_GROUP_NAME=
# Privileged group assignment is deliberately disabled by default.
ENABLE_ADMIN_GROUP_ASSIGNMENT=false
PASSWORD_LENGTH=14
DEFAULT_PASSWORD=
DISABLED_RETENTION_DAYS=180
COMPANY_NAME=Example Company

# Application security
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=true
PUBLIC_BASE_URL=https://sync.example.org
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
ADMIN_FALLBACK_ENABLED=false
ADMIN_FALLBACK_USERNAME=
# Generate a Werkzeug password hash; do not put a plaintext password here.
ADMIN_FALLBACK_PASSWORD_HASH=

# Telegram bot (optional; leave token empty to disable).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# Paths / runtime
TZ=UTC
ENV_FILE_PATH=/app/.env
SQLITE_PATH=/app/data/webui.db
SYNC_LOG_DIR=/app/sync-logs
AD_SCRIPTS_DIR=/ad-scripts
MESSAGE_LOG_DB_PATH=/app/shared-data/webui.db
CREDENTIAL_ENCRYPTION_KEY=
INSTRUCTION_URL=
MAIL_INSTRUCTION_URL=
